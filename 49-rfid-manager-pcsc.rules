// Allow the dedicated 'user' account non-interactive PC/SC access.
// pcsc-lite's default policy only allows access to an "active" (local seat)
// session; rfid-manager runs as a headless systemd service reached over SSH,
// which polkit otherwise treats as inactive and denies.
polkit.addRule(function(action, subject) {
    if ((action.id == "org.debian.pcsc-lite.access_pcsc" ||
         action.id == "org.debian.pcsc-lite.access_card") &&
        subject.user == "user") {
        return polkit.Result.YES;
    }
});
